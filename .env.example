# Copie este arquivo para .env e preencha com os valores reais do seu CRM.
# NUNCA commite o .env de verdade - ele contém uma credencial de API.

# URL do webhook de entrada do Bitrix24 (Configurações > Desenvolvedores > Webhooks de entrada).
# Formato: https://SEU-DOMINIO.bitrix24.com.br/rest/USER_ID/TOKEN
CRM_WEBHOOK_URL=https://exemplo.bitrix24.com.br/rest/0/token_de_exemplo

# Tipo e ID da entidade do CRM à qual os documentos serão vinculados na geração
# (ex: 7 = Orçamento/Quote clássico do Bitrix24; 2 = Negócio/Deal - depende de
# como os seus templates estão configurados, ver README).
CRM_ENTITY_TYPE_ID=7
CRM_ENTITY_ID=0
